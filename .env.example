# mini-agent 系统配置模板 —— 复制为 .env 后按需修改；不填的项使用注释里的默认值
# 优先级：命令行参数 > 本文件 / 环境变量 > 内置默认值
# 模型（服务商 / Key / 模型名）不在这里配置：启动 --web 后在「设置 → 模型」里配

# ---------------------------------------------------------------- Web 服务
# 监听地址：0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机
MINI_AGENT_HOST=0.0.0.0
# 监听端口
MINI_AGENT_PORT=8000
# 反向代理时额外允许的 Host 头（逗号分隔），一般留空
# MINI_AGENT_ALLOWED_HOSTS=

# ---------------------------------------------------------------- 数据与工作区
# 数据目录（配置 / 会话 / 账号库 / 日志），默认 ~/.mini-agent
# MINI_AGENT_DATA_DIR=
# 沙箱根目录（Agent 只能在这里读写），默认当前用户数据目录（如 ~/mini-agent）
# MINI_AGENT_WORKSPACE=

# ---------------------------------------------------------------- 运行限制
# 单个工具输出上限（字符），默认 8000
# MINI_AGENT_MAX_OUTPUT=8000
# 放开危险命令拦截：0 = 拦截（强烈建议），1 = 允许
# MINI_AGENT_ALLOW_DANGEROUS=0
# 没有审批界面时允许工具直接执行（自动化/脚本场景），默认 0
# MINI_AGENT_ALLOW_NO_ASKER=0

# ---------------------------------------------------------------- 设置项兜底
# 以下项正常在 Web UI「通用配置」里调；这里只是没保存过时的初始值
# MINI_AGENT_MAX_TURNS=10
# MINI_AGENT_MAX_CONTEXT=120000
# MINI_AGENT_KEEP_TURNS=8
# MINI_AGENT_STREAM=1
# MINI_AGENT_PARALLEL=1
# MINI_AGENT_MAX_WORKERS=4

# ---------------------------------------------------------------- 扩展
# 关闭插件 / 技能加载（排障用）
# MINI_AGENT_NO_PLUGINS=0
# MINI_AGENT_NO_SKILLS=0
# 额外插件 / 技能目录（多个用逗号或分号分隔）
# MINI_AGENT_PLUGIN_DIRS=
# MINI_AGENT_SKILL_DIRS=
# 前端产物目录（默认使用内置 web/dist）
# MINI_AGENT_WEB_DIST=
