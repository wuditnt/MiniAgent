# 复制为 .env 后填写。任何 OpenAI 兼容服务都可以（DeepSeek / 通义 / 智谱 / 本地 vLLM / Ollama ...）

# 必填：API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：接口地址（不填则用 OpenAI 官方）
# DeepSeek     https://api.deepseek.com/v1
# 通义千问      https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 GLM     https://open.bigmodel.cn/api/paas/v4
# 本地 Ollama  http://localhost:11434/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名（须支持 function calling）
OPENAI_MODEL=deepseek-chat

# 可选：限制 Agent 的活动范围（默认当前目录）
# AGENT_WORKSPACE=C:/work/sandbox

# 可选：单次工具输出上限（字符）
# AGENT_MAX_OUTPUT=8000

# 可选：放开危险命令拦截（默认 0，强烈建议保持关闭）
# AGENT_ALLOW_DANGEROUS=1
